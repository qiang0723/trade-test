# Coinglass API 配置示例
# 复制此文件为 .env 并填入真实值
# 注意：.env 文件已在 .gitignore 中，不会被提交到 Git

# Coinglass API Key（必需）
# 获取地址：https://www.coinglass.com/pricing
COINGLASS_API_KEY=your_api_key_here

# Coinglass API 基础URL（可选，有默认值）
# COINGLASS_BASE_URL=https://open-api-v4.coinglass.com

# 是否启用Coinglass数据源（可选，默认true）
# COINGLASS_ENABLED=true
